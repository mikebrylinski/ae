VITE_ADMIN_PASSWORD=change-me
# Same value as above; used by the gallery save/upload APIs in production.
ADMIN_PASSWORD=change-me

# Vercel Blob — gallery photos and private contact messages
# Store: https://twj9hkdxnej2mgbm.public.blob.vercel-storage.com
BLOB_STORE_ID=store_twJ9HkDXnej2Mgbm
# Write token from the Blob store page. Required for local saves.
BLOB_READ_WRITE_TOKEN=

# Contact form → Resend → info@andyebert.com
# Create a key at https://resend.com
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=info@andyebert.com
# pracdrum.com is verified on this Resend account, so mail can reach info@.
# After andyebert.com is verified, switch to:
# CONTACT_FROM_EMAIL=Andy Ebert <noreply@andyebert.com>
CONTACT_FROM_EMAIL=Andy Ebert <noreply@pracdrum.com>
# Contact submissions are stored in the same Blob store as the gallery.

# Admin → Analytics. Token from https://vercel.com/account/tokens with access to this project.
# On Vercel production: set VERCEL_ACCESS_TOKEN (and VERCEL_TEAM_ID if Analytics fails).
# VERCEL_PROJECT_ID is usually injected automatically when System Env Vars are enabled.
VERCEL_ACCESS_TOKEN=
# VERCEL_PROJECT_ID=prj_...
# VERCEL_TEAM_ID=team_...
