VITE_ADMIN_PASSWORD=change-me
# Same value as above; used by the gallery save/upload APIs in production.
ADMIN_PASSWORD=change-me

# Vercel Blob — live gallery metadata and new photo uploads
# Create a Blob store in the Vercel project, then paste the write token.
BLOB_READ_WRITE_TOKEN=

# Contact form → Resend → info@andyebert.com
# Create a key at https://resend.com
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=info@andyebert.com
# After verifying your domain in Resend, switch from to e.g.:
# CONTACT_FROM_EMAIL=Andy Ebert <noreply@andyebert.com>
CONTACT_FROM_EMAIL=Andy Ebert Contact <onboarding@resend.dev>
